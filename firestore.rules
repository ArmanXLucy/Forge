rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userRef(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Suspension is enforced for member data, but owners can still read their
    // root user document and use support so the suspension is explainable.
    function isSuspended(uid) {
      return exists(userRef(uid)) &&
        'accountStatus' in get(userRef(uid)).data &&
        get(userRef(uid)).data.accountStatus == 'suspended';
    }

    function activeOwner(uid) {
      return isOwner(uid) && !isSuspended(uid);
    }

    function adminRef() {
      return /databases/$(database)/documents/adminUsers/$(request.auth.uid);
    }

    function adminExists() {
      return signedIn() && exists(adminRef());
    }

    function adminData() {
      return get(adminRef()).data;
    }

    function isAdmin() {
      return adminExists() && adminData().active == true;
    }

    function hasRole(roles) {
      return isAdmin() && adminData().role in roles;
    }

    function canManageUsers() {
      return hasRole(['super_admin', 'admin']);
    }

    function canManageRoles() {
      return hasRole(['super_admin']);
    }

    function canManageContent() {
      return hasRole(['super_admin', 'admin', 'fitness_manager']);
    }

    function canSupport() {
      return hasRole(['super_admin', 'admin', 'support_manager']);
    }

    function canViewAnalytics() {
      return hasRole(['super_admin', 'admin', 'fitness_manager', 'support_manager', 'analyst']);
    }

    function canManagePlatform() {
      return hasRole(['super_admin']);
    }

    // AI monitoring and error data is operational, not member-facing. It is
    // readable only by the same administrators who can open the AI pages.
    function canManageAI() {
      return hasRole(['super_admin', 'admin']);
    }

    function ownsUserId(uid) {
      return !('userId' in request.resource.data) || request.resource.data.userId == uid;
    }

    function validAdminWrite(uid) {
      return request.resource.data.uid == uid &&
        request.resource.data.role in [
          'super_admin', 'admin', 'fitness_manager', 'support_manager', 'analyst'
        ] &&
        request.resource.data.active is bool &&
        request.resource.data.permissions is list;
    }

    function validAdminUserUpdate() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return diff.hasOnly([
        'fullName', 'accountStatus', 'adminNote', 'suspensionReason',
        'suspendedAt', 'suspendedBy', 'suspendedByName', 'updatedAt'
      ]) &&
        (!('accountStatus' in request.resource.data) ||
          request.resource.data.accountStatus in ['active', 'suspended']) &&
        (!('fullName' in request.resource.data) ||
          (request.resource.data.fullName is string &&
            request.resource.data.fullName.size() <= 120)) &&
        (!('suspensionReason' in request.resource.data) ||
          request.resource.data.suspensionReason == null ||
          (request.resource.data.suspensionReason is string &&
            request.resource.data.suspensionReason.size() <= 500)) &&
        (!('adminNote' in request.resource.data) ||
          request.resource.data.adminNote == null ||
          (request.resource.data.adminNote is string &&
            request.resource.data.adminNote.size() <= 1000));
    }

    function validAnnouncementWrite() {
      return request.resource.data.schemaVersion == 1 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 &&
        request.resource.data.title.size() <= 140 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() >= 10 &&
        request.resource.data.body.size() <= 4000 &&
        request.resource.data.status in ['draft', 'published', 'archived'] &&
        request.resource.data.tone in ['info', 'update', 'maintenance'] &&
        request.resource.data.createdBy is string &&
        request.resource.data.updatedAt is timestamp &&
        (request.resource.data.publishedAt == null ||
          request.resource.data.publishedAt is timestamp);
    }

    function validTicketCreate(ticketId) {
      return signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.ticketId is string &&
        request.resource.data.ticketId.size() <= 40 &&
        request.resource.data.status == 'open' &&
        request.resource.data.priority == 'medium' &&
        request.resource.data.category in ['account', 'workouts', 'ai-coach', 'nutrition', 'progress', 'technical', 'other'] &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() >= 4 &&
        request.resource.data.subject.size() <= 140 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 10 &&
        request.resource.data.description.size() <= 5000;
    }

    // Shape validation only. Passing these checks does not prove that a genuine
    // browser ONNX inference produced the plan; ownership and document shape are
    // enforceable here, model authenticity is not.
    function validMissionAnswerWrite(uid, missionId) {
      return request.resource.data.userId == uid &&
        request.resource.data.missionId == missionId &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.values is map &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.keys().hasAll([
          'missionId', 'userId', 'values', 'updatedAt', 'schemaVersion'
        ]) &&
        request.resource.data.keys().hasOnly([
          'missionId', 'userId', 'values', 'updatedAt', 'schemaVersion'
        ]);
    }

    function validRecommendationWrite(uid, recommendationId) {
      return request.resource.data.userId == uid &&
        request.resource.data.recommendationId == recommendationId &&
        request.resource.data.modelSource == 'onnx-web' &&
        request.resource.data.modelVersion is string &&
        request.resource.data.modelVersion.size() <= 40 &&
        request.resource.data.predictedPlanCategory is string &&
        request.resource.data.predictedPlanCategory.size() > 0 &&
        request.resource.data.predictedPlanCategory.size() <= 120 &&
        request.resource.data.planTemplateId is string &&
        request.resource.data.planTemplateId.size() <= 80 &&
        request.resource.data.planTitle is string &&
        request.resource.data.planTitle.size() > 0 &&
        request.resource.data.planTitle.size() <= 200 &&
        request.resource.data.fitnessGoal is string &&
        request.resource.data.datasetGoal is string &&
        request.resource.data.missionSnapshot is map &&
        request.resource.data.missionSnapshot.schemaVersion == 1 &&
        request.resource.data.missionSnapshot.answers is map &&
        request.resource.data.missionSnapshot.profile is map &&
        request.resource.data.schedule is list &&
        request.resource.data.schedule.size() == 7 &&
        request.resource.data.safety is map &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.isActive is bool &&
        request.resource.data.isOutdated is bool &&
        request.resource.data.version is int &&
        request.resource.data.version >= 1 &&
        request.resource.data.version <= 10000 &&
        request.resource.data.generationStatus in ['ready', 'superseded'] &&
        request.resource.data.inferenceMs is number &&
        request.resource.data.inferenceMs >= 0 &&
        request.resource.data.inferenceMs <= 600000 &&
        request.resource.data.confidence is number &&
        request.resource.data.confidence >= 0 &&
        request.resource.data.confidence <= 1 &&
        request.resource.data.classProbabilities is list &&
        request.resource.data.classProbabilities.size() <= 24 &&
        request.resource.data.keys().hasAll([
          'recommendationId', 'userId', 'modelVersion', 'modelSource',
          'predictedPlanCategory', 'planTemplateId', 'planTitle', 'fitnessGoal',
          'datasetGoal', 'missionSnapshot', 'schedule', 'safety', 'createdAt',
          'updatedAt', 'isActive', 'isOutdated', 'version', 'generationStatus',
          'inferenceMs', 'confidence', 'classProbabilities'
        ]) &&
        request.resource.data.keys().hasOnly([
          'recommendationId', 'userId', 'modelVersion', 'modelSource',
          'predictedPlanCategory', 'planTemplateId', 'planTitle', 'fitnessGoal',
          'datasetGoal', 'missionSnapshot', 'schedule', 'safety', 'createdAt',
          'updatedAt', 'isActive', 'isOutdated', 'version', 'generationStatus',
          'inferenceMs', 'confidence', 'classProbabilities'
        ]);
    }

    // Monitoring events are client-reported telemetry. Rules cannot prove that
    // an event came from a genuine inference, but they can force ownership,
    // a fixed schema, bounded values and a server timestamp. Official model
    // evaluation and registry data is never accepted here: it is generated
    // offline into a static artifact and deployed with the app.
    function validAIMonitoringEvent(eventId, uid) {
      let data = request.resource.data;
      return data.userId == uid &&
        data.eventId == eventId &&
        data.schemaVersion == 1 &&
        data.createdAt == request.time &&
        data.appVersion is string && data.appVersion.size() <= 32 &&
        data.feature in ['workout-recommendation', 'ai-coach'] &&
        data.eventType in [
          'recommendation.requested', 'recommendation.generated',
          'recommendation.failed', 'recommendation.saved',
          'recommendation.save_failed', 'model.load_started',
          'model.load_succeeded', 'model.load_failed', 'inference.started',
          'inference.succeeded', 'inference.failed', 'validation.passed',
          'validation.failed', 'coach.session.started',
          'coach.session.completed', 'coach.session.interrupted',
          'coach.session.failed', 'coach.session.saved'
        ] &&
        data.status in ['info', 'ok', 'error'] &&
        data.keys().hasAll([
          'schemaVersion', 'eventId', 'userId', 'appVersion', 'feature',
          'eventType', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'eventId', 'userId', 'appVersion', 'feature',
          'eventType', 'status', 'createdAt', 'sessionRef', 'modelId',
          'modelVersion', 'exercise', 'category', 'confidence', 'durationMs',
          'inferenceMsSum', 'inferenceCount', 'goodCount', 'badCount',
          'reps', 'errorCount', 'errorCategory', 'errorCode', 'message',
          'source'
        ]) &&
        (!('sessionRef' in data) || (data.sessionRef is string && data.sessionRef.size() <= 64)) &&
        (!('modelId' in data) || (data.modelId is string && data.modelId.size() <= 64)) &&
        (!('modelVersion' in data) || (data.modelVersion is string && data.modelVersion.size() <= 40)) &&
        (!('exercise' in data) || (data.exercise is string && data.exercise.size() <= 32)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 120)) &&
        (!('source' in data) || data.source in ['camera', 'video']) &&
        (!('confidence' in data) || (data.confidence is number && data.confidence >= 0 && data.confidence <= 1)) &&
        (!('durationMs' in data) || (data.durationMs is number && data.durationMs >= 0 && data.durationMs <= 86400000)) &&
        (!('inferenceMsSum' in data) || (data.inferenceMsSum is number && data.inferenceMsSum >= 0 && data.inferenceMsSum <= 86400000)) &&
        (!('inferenceCount' in data) || (data.inferenceCount is number && data.inferenceCount >= 0 && data.inferenceCount <= 100000)) &&
        (!('goodCount' in data) || (data.goodCount is number && data.goodCount >= 0 && data.goodCount <= 100000)) &&
        (!('badCount' in data) || (data.badCount is number && data.badCount >= 0 && data.badCount <= 100000)) &&
        (!('reps' in data) || (data.reps is number && data.reps >= 0 && data.reps <= 100000)) &&
        (!('errorCount' in data) || (data.errorCount is number && data.errorCount >= 0 && data.errorCount <= 100000)) &&
        (!('errorCategory' in data) || data.errorCategory in [
          'model_load', 'schema_load', 'feature_extraction', 'inference',
          'validation', 'persistence', 'camera', 'pose_detection', 'unknown'
        ]) &&
        (!('errorCode' in data) || (data.errorCode is string && data.errorCode.size() <= 64)) &&
        (!('message' in data) || (data.message is string && data.message.size() <= 240)) &&
        (data.status != 'error' ||
          ('errorCategory' in data && 'errorCode' in data));
    }
    // ---------------------------------------------------------------- users
    match /users/{uid} {
      // A suspended owner must still be able to read the root document so the
      // application can display the suspension reason and support path.
      allow get, list: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        (!('accountStatus' in request.resource.data) ||
          request.resource.data.accountStatus == 'active') &&
        !request.resource.data.keys().hasAny([
          'adminNote', 'role', 'permissions', 'isAdmin', 'adminRole'
        ]);
      allow update: if (isOwner(uid) &&
          resource.data.get('accountStatus', 'active') != 'suspended' &&
          (!('uid' in request.resource.data) || request.resource.data.uid == uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'accountStatus', 'adminNote', 'suspensionReason', 'suspendedAt',
            'suspendedBy', 'suspendedByName', 'role', 'permissions', 'isAdmin', 'adminRole'
          ])) ||
        (isOwner(uid) &&
          !('accountStatus' in resource.data) &&
          request.resource.data.accountStatus == 'active' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'accountStatus', 'updatedAt'
          ])) ||
        (canManageUsers() && validAdminUserUpdate());
      allow delete: if (isOwner(uid) &&
        resource.data.get('accountStatus', 'active') != 'suspended') || canManageRoles();

      match /{collection}/{docId} {
        // Support managers need ordinary member context for tickets, but not
        // medical answers or client-generated plans. Owner access is blocked
        // while suspended; support remains available outside this subtree.
        allow read: if activeOwner(uid) || canManageUsers() ||
          (isAdmin() && collection != 'mission_answers' && collection != 'workout_recommendations');
        // Sensitive collections are written only through their validated rules below.
        allow create, update: if activeOwner(uid) && ownsUserId(uid) &&
          collection != 'mission_answers' && collection != 'workout_recommendations';
        allow delete: if activeOwner(uid) || canManageRoles();
      }

      // Mission answers used by the AI workout plan. Owner-only for members;
      // sensitive answers are limited to user-management administrators.
      match /mission_answers/{missionId} {
        allow read: if activeOwner(uid) || canManageUsers();
        allow create, update: if activeOwner(uid) && validMissionAnswerWrite(uid, missionId);
        allow delete: if activeOwner(uid) || canManageRoles();
      }

      // Generated plans. Client-side ONNX generation writes these today, so the
      // owner may write their own documents. Validation restricts ownership,
      // required fields and the top-level shape; it cannot prove model inference.
      // When server-side inference exists, switch create/update to `if false`.
      match /workout_recommendations/{recommendationId} {
        allow read: if activeOwner(uid) || canManageUsers();
        allow create, update: if activeOwner(uid) && validRecommendationWrite(uid, recommendationId);
        allow delete: if activeOwner(uid) || canManageRoles();
      }
    }

    // Admin collection-group reads (overview / monitoring / analytics).
    match /{path=**}/workouts/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/missions/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/ai_sessions/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/nutrition_logs/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/progress_records/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/lifestyle_logs/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/workout_recommendations/{docId} {
      allow read: if canManageUsers();
    }
    match /{path=**}/mission_answers/{docId} {
      allow read: if canManageUsers();
    }

    // ------------------------------------------------------- AI monitoring
    // Members may create their own telemetry; only owners and AI admins may
    // read it. No client can update or delete an event (retention cleanup is
    // reserved to a super administrator). There is deliberately no rule for
    // evaluation results or model registry writes: those are static deployment
    // artifacts produced by scripts/evaluate-models.py.
    match /ai_monitoring_events/{eventId} {
      allow get: if activeOwner(resource.data.userId) || canManageAI();
      allow list: if canManageAI() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if activeOwner(request.auth.uid) &&
        validAIMonitoringEvent(eventId, request.auth.uid);
      allow update: if false;
      allow delete: if canManagePlatform();
    }
    // ----------------------------------------------------------- admin roles
    match /adminUsers/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if canManageRoles() && validAdminWrite(uid);
      allow update: if (canManageRoles() && validAdminWrite(uid)) ||
        (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastLoginAt', 'updatedAt']));
      allow delete: if canManageRoles() && uid != request.auth.uid;
    }

    // ---------------------------------------------------------- help desk
    match /supportTickets/{ticketId} {
      allow get: if isOwner(resource.data.userId) || canSupport();
      allow list: if canSupport() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if validTicketCreate(ticketId);
      allow update: if canSupport() ||
        (isOwner(resource.data.userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'lastMessageAt', 'updatedAt', 'messageCount'
          ]) &&
          (request.resource.data.status == resource.data.status ||
            ((resource.data.status == 'resolved' || resource.data.status == 'waiting_for_user') &&
              request.resource.data.status == 'open')));
      allow delete: if canManageRoles();

      match /messages/{messageId} {
        allow read: if canSupport() ||
          (signedIn() && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid);
        allow create: if
          (signedIn() &&
            request.resource.data.senderRole == 'user' &&
            request.resource.data.senderId == request.auth.uid &&
            get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid &&
            get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.status != 'closed') ||
          (canSupport() &&
            request.resource.data.senderRole == 'admin' &&
            request.resource.data.senderId == request.auth.uid);
        allow update, delete: if false;
      }

      match /internal_notes/{noteId} {
        allow read: if canSupport();
        allow create: if canSupport() &&
          request.resource.data.adminId == request.auth.uid;
        allow update, delete: if canManageRoles();
      }
    }

    // -------------------------------------------------------- notifications
    match /notifications/{notificationId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if
        (isOwner(resource.data.userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------- admin logs
    match /adminActivityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }

    // ------------------------------------------------------ content catalog
    // Members can discover published coaching content. Drafts and archived
    // records remain visible only to content administrators.
    match /workoutPlans/{docId} {
      allow get, list: if canManageContent() ||
        (signedIn() && resource.data.status == 'published');
      allow write: if canManageContent();
    }
    match /exerciseLibrary/{docId} {
      allow get, list: if signedIn();
      allow write: if canManageContent();
    }
    match /nutritionPlans/{docId} {
      allow get, list: if canManageContent() ||
        (signedIn() && resource.data.status == 'published');
      allow write: if canManageContent();
    }
    match /missionSettings/{missionId} {
      allow read: if signedIn();
      allow write: if canManageContent();
    }
    match /platformSettings/{docId} {
      allow read, write: if canManagePlatform();
    }

    // --------------------------------------------------------- announcements
    match /announcements/{announcementId} {
      allow get, list: if canManagePlatform() ||
        (signedIn() && resource.data.status == 'published');
      allow create: if canManagePlatform() && validAnnouncementWrite();
      allow update: if canManagePlatform() && validAnnouncementWrite();
      allow delete: if canManagePlatform();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
