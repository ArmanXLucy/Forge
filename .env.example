# Firebase Authentication configuration
# Copy this file to `.env` and fill in the values from your Firebase project:
# Console → Project settings → General → Your apps → Web app configuration.
#
# All four values are required for real authentication. If any are missing,
# the app clearly shows that Firebase is not configured and offers a local
# demo workspace instead. Never commit your real `.env` file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Supabase Storage (profile photos)
# Create a Supabase project, then copy the project URL and the publishable/anon
# key from Project Settings → API. Never use the service-role key in Vite variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Recommended: deploy supabase/functions/profile-image and paste its URL here.
# This lets the function verify the Firebase ID token and keep the service role
# key server-side.
# Example: https://<project-ref>.supabase.co/functions/v1/profile-image
VITE_SUPABASE_UPLOAD_FUNCTION_URL=

# Local emulator integration testing only. Never enable against production data.
VITE_USE_FIREBASE_EMULATORS=
