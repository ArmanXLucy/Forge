rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsUserId(uid) {
      return !('userId' in request.resource.data) ||
        request.resource.data.userId == uid;
    }

    // Every user-owned document lives under users/{uid}. A user may only read
    // or write documents in their own subtree. All other paths are denied.
    match /users/{uid} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == uid);
      allow delete: if isOwner(uid);

      match /{collection}/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && ownsUserId(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
