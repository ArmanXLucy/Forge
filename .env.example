# Firebase Authentication configuration
# Copy this file to `.env` and fill in the values from your Firebase project:
# Console → Project settings → General → Your apps → Web app configuration.
#
# All four values are required for real authentication. If any are missing,
# the app clearly shows that Firebase is not configured and offers a local
# demo workspace instead. Never commit your real `.env` file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
