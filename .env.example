# Forge Athletic — environment example
#
# Copy this file to `.env` for local development and fill in the values.
# Never commit `.env`, and never put server-only secrets in a VITE_ variable:
# Vite embeds every VITE_ value into the public browser bundle.

# ---------------------------------------------------------------------------
# Public frontend configuration (safe to expose in the browser bundle)
# ---------------------------------------------------------------------------
# Firebase Console → Project settings → General → Your apps → Web app config.
# These are public identifiers, not server credentials. Access is controlled by
# Firebase Authentication and Firestore security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Supabase Storage (profile photos). Use the project URL and the publishable /
# anon key. Never use a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deployed `supabase/functions/profile-image` URL. The function verifies the
# Firebase ID token and keeps the service-role key server-side.
# Example: https://<project-ref>.supabase.co/functions/v1/profile-image
VITE_SUPABASE_UPLOAD_FUNCTION_URL=

# Local emulator integration only. Never enable against production data.
VITE_USE_FIREBASE_EMULATORS=

# ---------------------------------------------------------------------------
# Server-only Supabase Edge Function secrets
# ---------------------------------------------------------------------------
# These are configured with the Supabase CLI or dashboard. They must NEVER be
# prefixed with VITE_, committed, or placed in frontend code.
#
#   FIREBASE_PROJECT_ID          Firebase project used to verify ID tokens
#   STORAGE_URL                  Supabase project URL used by the function
#   STORAGE_SERVICE_ROLE_KEY     Server-only key used for Storage operations
#
# The function also accepts the platform-provided SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY as fallbacks. If a service-role key is ever exposed,
# rotate it in Supabase immediately; removing it from a file is not enough.
#
#   supabase secrets set \
#     FIREBASE_PROJECT_ID=<firebase-project-id> \
#     STORAGE_URL=<supabase-project-url> \
#     STORAGE_SERVICE_ROLE_KEY=<server-only-key> \
#     --project-ref <supabase-project-ref>
