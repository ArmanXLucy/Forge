{
  "version": "1.0.0",
  "unit": "one clip (exercise set)",
  "pose_model": "pose_landmarker_full.task",
  "feature_order": [
    "knee_min",
    "knee_max",
    "knee_rom",
    "knee_std",
    "knee_iqr",
    "hip_min",
    "hip_max",
    "hip_rom",
    "hip_std",
    "hip_iqr",
    "elbow_min",
    "elbow_max",
    "elbow_rom",
    "elbow_std",
    "elbow_iqr",
    "shoulder_min",
    "shoulder_max",
    "shoulder_rom",
    "shoulder_std",
    "shoulder_iqr",
    "ankle_min",
    "ankle_max",
    "ankle_rom",
    "ankle_std",
    "ankle_iqr",
    "torso_mean",
    "torso_max",
    "torso_std",
    "torso_rom",
    "sway_std",
    "sway_maxabs",
    "sway_range",
    "knee_dev_mean",
    "knee_dev_max",
    "knee_dev_asym_mean",
    "knee_width_min",
    "knee_width_max",
    "ankle_width_mean",
    "hip_drop_range",
    "hip_drop_min",
    "shoulder_drop_range",
    "knee_lr_diff_mean",
    "elbow_lr_diff_mean",
    "wrist_l_range",
    "wrist_r_range",
    "wrist_l_max",
    "wrist_r_max",
    "knee_vel_absmean",
    "elbow_vel_absmean",
    "rep_rate_per_sec",
    "angle_range_clip",
    "rep_period_mean",
    "rep_period_std",
    "rep_period_cv",
    "rep_period_min",
    "rep_period_max",
    "frac_below_25pct",
    "frac_above_75pct",
    "frac_mid",
    "rom_per_rep"
  ],
  "feature_source": "ml/fitness_features.py + ml/experiment_clip.py + ml/experiment_repmetry.py",
  "class_order": [
    "BAD",
    "GOOD"
  ],
  "thresholds": {
    "squat": 0.66,
    "bicep_curl": 0.64,
    "push_up": 0.58
  },
  "notes": [
    "Input: float32 [N, len(feature_order)]; NaN allowed (median imputer is in the graph).",
    "Output 'probabilities' columns are [BAD, GOOD]; compare col 1 to the threshold.",
    "Trained on 25-26 participants; validated on participants never seen in training.",
    "Measured accuracy is modest - use as a secondary signal, not the sole verdict."
  ]
}