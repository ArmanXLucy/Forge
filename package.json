{
  "name": "forge-athletic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "model:assets": "node scripts/copy-model-assets.mjs",
    "verify:assets": "node scripts/verify-model-assets.mjs",
    "predev": "npm run model:assets",
    "prebuild": "npm run model:assets",
    "postbuild": "node scripts/verify-model-assets.mjs dist",
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools@13.35.1 emulators:exec --only firestore --project forge-phase1-rules \"npx vitest run tests/firestore.rules.test.ts\"",
    "eval:models": "workout-recommendation\\.venv\\Scripts\\python.exe scripts/evaluate-models.py",
    "eval:models:check": "workout-recommendation\\.venv\\Scripts\\python.exe scripts/evaluate-models.py --check"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.62.7",
    "clsx": "^2.1.1",
    "firebase": "^11.1.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "supabase": "^3.2.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@fontsource-variable/dm-sans": "^5.1.0",
    "@fontsource/anton": "^5.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
